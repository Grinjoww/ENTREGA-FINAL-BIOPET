# frontend/nginx.conf.template
# Plantilla de configuracion de nginx del frontend. Se convierte en
# /etc/nginx/conf.d/default.conf en tiempo de arranque del contenedor
# (frontend/docker-entrypoint.sh), sustituyendo UNICAMENTE la variable
# BACKEND_URL que aparece abajo en "proxy_pass" -- nunca se hardcodea aqui
# una URL fija, para que el mismo archivo sirva tanto para Docker Compose
# local (default BACKEND_URL=http://backend:8080, ver
# docker-entrypoint.sh) como para Render (BACKEND_URL = URL HTTPS publica
# real del servicio biopet-backend, inyectada por render.yaml). Un solo
# archivo fuente, sin duplicar configuraciones por entorno.
#
# Por que una URL publica y no el hostname privado de Render: verificado
# en un deploy real que el plan Free de Web Services de Render puede
# ENVIAR trafico por la red privada pero NO puede RECIBIRLO -- el
# frontend Free no puede consumir al backend Free por ese hostname
# privado ("host not found in upstream" al intentarlo). La URL publica
# HTTPS del backend, ya desplegado y accesible, evita ese limite.
#
# NOTA: como envsubst reemplaza texto de forma literal (tambien dentro de
# comentarios), este encabezado evita a proposito escribir la sintaxis
# real "dolar-llave-BACKEND_URL-llave" para no verse alterado en el
# archivo final generado; la sintaxis real solo aparece, sin comentar, en
# la linea "proxy_pass" de abajo.
#
# Las variables propias de nginx ($host, $remote_addr,
# $proxy_add_x_forwarded_for, $scheme) NO se tocan: docker-entrypoint.sh
# restringe envsubst exclusivamente a BACKEND_URL, por lo que estas
# quedan literalmente intactas en el archivo final.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;

        # Cabeceras de seguridad del frontend estatico servido por este
        # nginx (biopet-frontend.onrender.com). Solo en location / (no en
        # /api/, cuyas respuestas ya llegan con sus propias cabeceras desde
        # el backend -- ver Backend/.../SecurityConfig.java y
        # docs/mediciones/sec/A05-security-headers.md -- para no duplicar
        # ni pisar esas cabeceras al hacer proxy_pass).
        #
        # "always" asegura que se envien tambien en respuestas de error
        # (4xx/5xx), no solo en 2xx.
        #
        # CSP explicada directiva por directiva:
        #   default-src 'self'      -- todo lo no cubierto abajo, solo mismo origen.
        #   script-src  'self' 'unsafe-inline'
        #                            -- los bundles JS de Angular son 'self'
        #                               (archivos externos con hash); 'unsafe-inline'
        #                               es necesario por el atributo
        #                               onload="this.media='all'" que Angular/Critters
        #                               inyecta en el <link> de estilos del build de
        #                               produccion (verificado inspeccionando
        #                               frontend/dist/biopet-frontend/browser/index.html
        #                               tras `npm run build`) -- sin esto, el CSS
        #                               principal nunca terminaria de cargar.
        #   style-src   'self' 'unsafe-inline'
        #                            -- Angular inyecta <style> por componente en
        #                               tiempo de ejecucion (View Encapsulation) y
        #                               tambien inline CSS critico en el build; sin
        #                               'unsafe-inline' la aplicacion se renderiza
        #                               sin estilos.
        #   img-src 'self' data:    -- iconos/imagenes embebidas como data URI.
        #   font-src 'self' data:
        #   connect-src 'self' BACKEND_URL
        #                            -- las llamadas a la API van a /api/ del MISMO
        #                               origen (proxy_pass de este nginx hacia el
        #                               backend), por lo que 'self' es lo que se
        #                               ejerce en la practica; BACKEND_URL se deja
        #                               declarado de forma explicita para no romper
        #                               un despliegue en el que el frontend tuviera
        #                               que llamar al backend directamente, sin
        #                               pasar por este proxy.
        #   frame-ancestors 'none'  -- equivalente moderno de X-Frame-Options DENY.
        #   object-src 'none'
        #   base-uri 'self'
        #
        # TODO (mejora futura, fuera de alcance de este cambio): migrar a una
        # CSP basada en nonce/hash para script-src/style-src y eliminar
        # 'unsafe-inline'; requeriria configurar ANGULAR_CSP_NONCE en el build
        # y ajustar el server-side rendering del nonce en index.html, que este
        # proyecto no usa hoy (SPA pura, sin SSR).
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ${BACKEND_URL}; frame-ancestors 'none'; object-src 'none'; base-uri 'self'" always;
        # HSTS: nginx no sabe si esta detras de un edge TLS (Render/Cloudflare
        # terminan HTTPS antes de este contenedor); se emite siempre, igual
        # que hace el backend (ver A05-security-headers.md) -- un navegador
        # solo la respeta sobre una respuesta HTTPS real de todas formas.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    }

    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Necesario cuando BACKEND_URL es un destino HTTPS por nombre
        # (p.ej. Render, detras de un edge con SNI): sin esto, nginx no
        # envia el SNI correcto en el handshake TLS hacia el backend y la
        # conexion puede fallar. Sin efecto cuando BACKEND_URL es HTTP
        # (Docker Compose local).
        proxy_ssl_server_name on;
    }
}
