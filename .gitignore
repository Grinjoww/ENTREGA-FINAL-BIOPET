# Java
Backend/target/
*.class
*.jar
# Python (bytecode cacheado al ejecutar scripts/*.py, p. ej. perf-analysis.py)
__pycache__/
*.pyc
# Node
frontend/node_modules/
frontend/dist/
frontend/.angular/
# Env
.env
*.log
# Postman: entorno local con valores reales (la plantilla sin secretos si se versiona)
docs/postman/*.local.postman_environment.json
# Certificados de desarrollo local (HTTPS/TLS BIOPET) - nunca versionar el keystore real
Backend/certs/*
!Backend/certs/.gitkeep
# IDE
.idea/
.vscode/
*.iml
# OS
.DS_Store
Thumbs.db
cookies.txt

# Salida cruda de lhci autorun (se archiva ya procesada en docs/mediciones/lighthouse/)
.lighthouseci/
.lighthouseci-desktop/
.lighthouseci-render/
.lighthouseci-render-desktop/

# Directorio temporal de scripts/run-zap-authenticated-local.sh (plan de
# ZAP con credenciales ya sustituidas desde variables de entorno; se
# borra automaticamente al terminar el script, nunca deberia commitearse)
.zap-auth-local-tmp.*/

# Insumos de retroalimentacion/evaluacion del docente (TXT + PDF de la
# guia de recalificacion), usados como material de consulta local para
# la auditoria de esta entrega: no forman parte del entregable academico
# y nunca deben versionarse en el repositorio.
auditoria-final/