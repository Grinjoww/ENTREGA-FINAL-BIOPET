digraph C4L3 {
  graph [rankdir=TB, dpi=200, bgcolor="white", fontname="Arial", label="BIOPET - C4 Level 3: Backend Components (v1.0.0)", labelloc=t, fontsize=22, nodesep=0.45, ranksep=0.7, compound=true];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#334155", fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=9, color="#475569"];

  frontend [label="Frontend\nAngular 17 + Nginx", shape=box, style="rounded,filled", fillcolor="#DCFCE7", color="#166534"];

  subgraph cluster_controllers {
    label="REST API / Controllers"; style="rounded,filled"; fillcolor="#E0E7FF"; color="#3730A3"; fontname="Arial"; fontsize=13;
    AuthController [label="AuthController\n/api/auth/*", fillcolor="#C7D2FE"];
    PetController [label="PetController\n/api/mascotas/*", fillcolor="#C7D2FE"];
    UserController [label="UserController\n/api/usuarios/me", fillcolor="#C7D2FE"];
    AppointmentController [label="AppointmentController\n/api/citas/*", fillcolor="#C7D2FE"];
    ConsultationController [label="ConsultationController\n/api/consultas/*", fillcolor="#C7D2FE"];
    VaccineController [label="VaccineController\n/api/vacunas/*", fillcolor="#C7D2FE"];
    ExternalApiController [label="ExternalApiController\n/api/externa/especies/*", fillcolor="#C7D2FE"];
  }

  subgraph cluster_services {
    label="Application services"; style="rounded,filled"; fillcolor="#DBEAFE"; color="#1D4ED8"; fontname="Arial"; fontsize=13;
    AuthService [label="AuthService", fillcolor="#BFDBFE"];
    PetService [label="PetService", fillcolor="#BFDBFE"];
    AppointmentService [label="AppointmentService", fillcolor="#BFDBFE"];
    ConsultationService [label="ConsultationService", fillcolor="#BFDBFE"];
    VaccineService [label="VaccineService", fillcolor="#BFDBFE"];
    ExternalApiService [label="ExternalApiService\n(cache TTL)", fillcolor="#BFDBFE"];
    ExternalApiClient [label="ExternalApiClient", fillcolor="#BFDBFE"];
  }

  subgraph cluster_security {
    label="Security and authentication"; style="rounded,filled"; fillcolor="#FEE2E2"; color="#B91C1C"; fontname="Arial"; fontsize=13;
    SecurityConfig [label="SecurityConfig", fillcolor="#FECACA"];
    JwtAuthFilter [label="JwtAuthenticationFilter", fillcolor="#FECACA"];
    JwtService [label="JwtService", fillcolor="#FECACA"];
    JwtCookieService [label="JwtCookieService", fillcolor="#FECACA"];
    UserDetailsSvc [label="UserDetailsServiceImpl", fillcolor="#FECACA"];
    RateLimiter [label="LoginRateLimiterService\n(in-memory, per IP)", fillcolor="#FECACA"];
    Blacklist [label="TokenBlacklistService", fillcolor="#FECACA"];
    AuditService [label="AuthenticationAuditService", fillcolor="#FECACA"];
    AuthEntryPoint [label="ProblemAuthenticationEntryPoint\n(401)", fillcolor="#FCA5A5"];
    AccessDeniedHandler [label="ProblemAccessDeniedHandler\n(403)", fillcolor="#FCA5A5"];
  }

  subgraph cluster_errors {
    label="Error handling"; style="rounded,filled"; fillcolor="#FEF3C7"; color="#92400E"; fontname="Arial"; fontsize=13;
    GlobalExceptionHandler [label="GlobalExceptionHandler", fillcolor="#FDE68A"];
    ProblemDetailFactory [label="ProblemDetailFactory", fillcolor="#FDE68A"];
  }

  subgraph cluster_persistence {
    label="Persistence (Spring Data JPA)"; style="rounded,filled"; fillcolor="#E9D5FF"; color="#6B21A8"; fontname="Arial"; fontsize=13;
    UserRepo [label="UserRepository", fillcolor="#DDD6FE"];
    PetRepo [label="PetRepository", fillcolor="#DDD6FE"];
    AppointmentRepo [label="AppointmentRepository", fillcolor="#DDD6FE"];
    ConsultationRepo [label="ConsultationRepository", fillcolor="#DDD6FE"];
    VaccineRepo [label="VaccineRepository", fillcolor="#DDD6FE"];
    ProcedureRepo [label="BiopetProcedureRepository\n(@Procedure /\n@NamedStoredProcedureQuery)", fillcolor="#DDD6FE"];
  }

  subgraph cluster_infra {
    label="Server infrastructure"; style="rounded,filled"; fillcolor="#E2E8F0"; color="#334155"; fontname="Arial"; fontsize=13;
    TomcatDual [label="TomcatDualConnectorConfig\nprofile 'tls'", fillcolor="#CBD5E1"];
  }

  postgres [label="PostgreSQL\n16 (dev) / 18 (prod)", shape=cylinder, style="filled", fillcolor="#FDE68A", color="#92400E"];
  redis [label="Redis / Valkey\n7 (dev) / 8 (prod)", shape=cylinder, style="filled", fillcolor="#FECACA", color="#B91C1C"];
  flyway [label="Flyway\nclasspath:db/migration\nV1..V6", shape=box, style="rounded,filled", fillcolor="#FEF9C3", color="#92400E"];
  logs [label="Local process logs\n(stdout / container)", shape=note, style="filled", fillcolor="#F1F5F9", color="#334155"];
  animalApi [label="API Ninjas\n(Animals API)\n[External System]", shape=box, style="rounded,dashed", fillcolor="#F1F5F9", color="#94A3B8", fontcolor="#64748B"];

  frontend -> AuthController [label="HTTPS/JSON + cookies\naccess_token, refresh_token"];
  frontend -> PetController [label="HTTPS/JSON + cookie access_token"];
  frontend -> UserController [label="HTTPS/JSON + cookie access_token"];
  frontend -> AppointmentController [label="HTTPS/JSON + cookie access_token"];
  frontend -> ConsultationController [label="HTTPS/JSON + cookie access_token"];
  frontend -> VaccineController [label="HTTPS/JSON + cookie access_token"];
  frontend -> ExternalApiController [label="HTTPS/JSON + cookie access_token"];

  AuthController -> AuthService [label="register/login/refresh/logout"];
  AuthController -> JwtCookieService [label="reads/writes cookies"];
  PetController -> PetService [label="list/search/create/update/delete"];
  UserController -> AuthService [label="profile (email)"];
  AppointmentController -> AppointmentService [label="CRUD / bulk status update"];
  ConsultationController -> ConsultationService [label="register/query consultations"];
  VaccineController -> VaccineService [label="CRUD vaccine records"];
  ExternalApiController -> ExternalApiService [label="get species info"];

  AuthService -> UserRepo [label="finds/creates user"];
  AuthService -> JwtService [label="generates/validates JWT"];
  AuthService -> RateLimiter [label="checks/records login attempts"];
  AuthService -> AuditService [label="LOGIN_*/REFRESH_*/LOGOUT_SUCCESS"];
  AuthService -> Blacklist [label="revoke / isRevoked\n(refresh, logout)"];

  PetService -> PetRepo [label="CRUD"];
  PetService -> UserRepo [label="validates owner/role"];
  PetService -> redis [label="cache reads/writes\n(@Cacheable/@CacheEvict)", style=dashed];

  AppointmentService -> AppointmentRepo [label="CRUD / bulk update"];
  AppointmentService -> UserRepo [label="validates veterinarian role"];
  ConsultationService -> ConsultationRepo [label="CRUD"];
  ConsultationService -> UserRepo [label="validates veterinarian/access"];
  VaccineService -> VaccineRepo [label="CRUD"];

  ExternalApiService -> ExternalApiClient [label="fetches species data"];
  ExternalApiService -> redis [label="caches response (TTL)", style=dashed];
  ExternalApiClient -> animalApi [label="GET species data\n[HTTPS/JSON]", style=dashed, color="#64748B"];

  JwtAuthFilter -> JwtCookieService [label="reads access_token cookie"];
  JwtAuthFilter -> JwtService [label="validates signature/claims/type"];
  JwtAuthFilter -> Blacklist [label="isRevoked(jti)"];
  JwtAuthFilter -> AuditService [label="TOKEN_REVOKED"];
  JwtAuthFilter -> UserDetailsSvc [label="loadUserByUsername"];

  SecurityConfig -> JwtAuthFilter [label="registers in the filter chain"];
  SecurityConfig -> AuthEntryPoint [label="401 entry point"];
  SecurityConfig -> AccessDeniedHandler [label="403 access-denied handler"];
  SecurityConfig -> UserDetailsSvc [label="DaoAuthenticationProvider"];

  AuthEntryPoint -> ProblemDetailFactory [label="builds 401"];
  AccessDeniedHandler -> ProblemDetailFactory [label="builds 403"];
  GlobalExceptionHandler -> ProblemDetailFactory [label="builds 4xx/429"];

  Blacklist -> redis [label="StringRedisTemplate"];
  UserRepo -> postgres [label="JDBC/JPA"];
  PetRepo -> postgres [label="JDBC/JPA"];
  AppointmentRepo -> postgres [label="JDBC/JPA"];
  ConsultationRepo -> postgres [label="JDBC/JPA"];
  VaccineRepo -> postgres [label="JDBC/JPA"];
  ProcedureRepo -> postgres [label="invokes stored procedures\n(@Procedure/@NamedStoredProcedureQuery)"];

  AuditService -> logs [label="AUTH_AUDIT\ntimestamp/event/result/ip/subject"];
  frontend -> TomcatDual [label="HTTPS :8443 (public)\nHTTP :8080 (internal)", style=dashed];
  flyway -> postgres [label="applies schema on startup\n(once, before serving traffic)", style=dotted];
}
