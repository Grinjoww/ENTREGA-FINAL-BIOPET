digraph Classes {
  graph [rankdir=TB, dpi=200, bgcolor="white", fontname="Arial", label="BIOPET - Backend Spring Boot Class Diagram", labelloc=t, fontsize=22, nodesep=0.6, ranksep=0.7];
  node [shape=record, style="rounded,filled", fillcolor="#F8FAFC", color="#334155", fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#475569"];
  // NOTE: box labels use conceptual English names. Physical identifiers keep
  // their implemented form (see Backend/src/main/java and Flyway migrations).
  User [label="{entity.User| - id: Long\l - name: String\l - email: String\l - passwordHash: String\l - role: Role\l - active: boolean\l - createdAt: Instant\l - updatedAt: Instant\l| + prePersist(): void\l + preUpdate(): void\l}", fillcolor="#ECFDF5"];
  Pet [label="{entity.Pet| - id: Long\l - owner: User\l - name: String\l - species: String\l - breed: String\l - birthDate: LocalDate\l - active: boolean\l| + prePersist(): void\l + preUpdate(): void\l}", fillcolor="#ECFDF5"];
  UserRepo [label="{repository.UserRepository| + findByEmail(email): Optional&lt;User&gt;\l + findByEmailAndActive(email): Optional&lt;User&gt;\l + existsByEmail(email): boolean\l}", fillcolor="#FEF3C7"];
  PetRepo [label="{repository.PetRepository| + findAllActive(pageable): Page&lt;Pet&gt;\l + findByIdAndActive(id): Optional&lt;Pet&gt;\l}", fillcolor="#FEF3C7"];
  AuthService [label="{service.AuthService| - userRepository\l - passwordEncoder\l - authenticationManager\l - jwtService\l - blacklistService\l| + register(request): UserResponse\l + login(request): AuthResponse\l + refresh(request): AuthResponse\l + logout(tokens): void\l + profile(email): UserResponse\l}", fillcolor="#DBEAFE"];
  PetService [label="{service.PetService| - petRepository\l - userRepository\l| + listAll(pageable): Page&lt;PetResponse&gt;\l + findById(id): PetResponse\l + create(request): PetResponse\l + update(id, request): PetResponse\l + delete(id): void\l}", fillcolor="#DBEAFE"];
  JwtService [label="{security.JwtService| - key: SecretKey\l - expirationMs: long\l| + generateAccessToken(user): String\l + generateRefreshToken(user): String\l + extractClaims(token): Claims\l + extractJti(token): String\l}", fillcolor="#FEE2E2"];
  JwtFilter [label="{security.JwtAuthenticationFilter| - jwtService\l - blacklistService\l - userDetailsService\l| + doFilterInternal(...): void\l}", fillcolor="#FEE2E2"];
  Blacklist [label="{security.TokenBlacklistService| - redisTemplate\l| + revoke(jti, expiresAt): void\l + isRevoked(jti): boolean\l}", fillcolor="#FEE2E2"];
  AuthController [label="{controller.AuthController| + register(request)\l + login(request)\l + refresh(request)\l + logout(request)\l}", fillcolor="#E0E7FF"];
  PetController [label="{controller.PetController| + listAll(pageable)\l + findById(id)\l + create(request)\l + update(id, request)\l + delete(id)\l}", fillcolor="#E0E7FF"];
  SecurityConfig [label="{config.SecurityConfig| + securityFilterChain(http)\l + corsConfigurationSource()\l + passwordEncoder()\l}", fillcolor="#F5D0FE"];
  User -> Pet [label="1 owner / 0..* pets"];
  AuthController -> AuthService;
  PetController -> PetService;
  AuthService -> UserRepo;
  AuthService -> JwtService;
  AuthService -> Blacklist;
  PetService -> PetRepo;
  PetService -> UserRepo;
  JwtFilter -> JwtService;
  JwtFilter -> Blacklist;
  SecurityConfig -> JwtFilter;
}
