' Conceptual English view of the backend domain. Physical identifiers keep
' their implemented form (see Backend/src/main/java and Flyway migrations).
@startuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package entity {
  enum Role { ROLE_ADMIN; ROLE_VETERINARIO; ROLE_DUENO; ROLE_AUXILIAR }
  class User <<Entity>> {
    - Long id
    - String name
    - String email
    - String passwordHash
    - Role role
    - boolean active
    - Instant createdAt
    - Instant updatedAt
    + prePersist(): void
    + preUpdate(): void
  }
  class Pet <<Entity>> {
    - Long id
    - User owner
    - String name
    - String species
    - String breed
    - LocalDate birthDate
    - boolean active
    - Instant createdAt
    - Instant updatedAt
    + prePersist(): void
    + preUpdate(): void
  }
}

package dto {
  record LoginRequest
  record RegistrationRequest
  record AuthResponse
  record RefreshRequest
  record UserResponse
  record PetRequest
  record PetResponse
}

package repository {
  interface UserRepository {
    + findByEmail(email: String): Optional<User>
    + findByEmailAndActive(email: String): Optional<User>
    + existsByEmail(email: String): boolean
  }
  interface PetRepository {
    + findAllActive(pageable: Pageable): Page<Pet>
    + findByIdAndActive(id: Long): Optional<Pet>
  }
}

package service {
  class AuthService {
    - UserRepository userRepository
    - PasswordEncoder passwordEncoder
    - AuthenticationManager authenticationManager
    - JwtService jwtService
    - TokenBlacklistService blacklistService
    + register(request: RegistrationRequest): UserResponse
    + login(request: LoginRequest): AuthResponse
    + refresh(request: RefreshRequest): AuthResponse
    + logout(tokens: String): void
    + profile(email: String): UserResponse
  }
  class PetService {
    - PetRepository petRepository
    - UserRepository userRepository
    + listAll(pageable: Pageable): Page<PetResponse>
    + findById(id: Long): PetResponse
    + create(request: PetRequest): PetResponse
    + update(id: Long, request: PetRequest): PetResponse
    + delete(id: Long): void
  }
  class UserDetailsServiceImpl {
    - UserRepository userRepository
    + loadUserByUsername(email: String): UserDetails
  }
}

package security {
  class JwtService {
    - SecretKey key
    - long expirationMs
    - long refreshExpirationMs
    + generateAccessToken(user: User): String
    + generateRefreshToken(user: User): String
    + extractClaims(token: String): Claims
    + extractEmail(token: String): String
    + extractJti(token: String): String
    + extractExpiration(token: String): Instant
    + isAccessToken(token: String): boolean
    + isRefreshToken(token: String): boolean
  }
  class JwtAuthenticationFilter {
    - JwtService jwtService
    - TokenBlacklistService blacklistService
    - UserDetailsServiceImpl userDetailsService
    + doFilterInternal(request, response, filterChain): void
  }
  class TokenBlacklistService {
    - StringRedisTemplate redisTemplate
    + revoke(jti: String, expiresAt: Instant): void
    + isRevoked(jti: String): boolean
  }
}

package controller {
  class AuthController {
    - AuthService authService
    + register(request: RegistrationRequest): ResponseEntity<UserResponse>
    + login(request: LoginRequest): ResponseEntity<AuthResponse>
    + refresh(request: RefreshRequest): ResponseEntity<AuthResponse>
    + logout(request: HttpServletRequest): ResponseEntity<Void>
  }
  class UserController {
    - AuthService authService
    + me(userDetails: UserDetails): UserResponse
  }
  class PetController {
    - PetService petService
    + listAll(pageable: Pageable): Page<PetResponse>
    + findById(id: Long): PetResponse
    + create(request: PetRequest): ResponseEntity<PetResponse>
    + update(id: Long, request: PetRequest): PetResponse
    + delete(id: Long): ResponseEntity<Void>
  }
}

package config {
  class SecurityConfig {
    + securityFilterChain(http: HttpSecurity): SecurityFilterChain
    + corsConfigurationSource(): CorsConfigurationSource
    + authenticationProvider(): AuthenticationProvider
    + authenticationManager(configuration: AuthenticationConfiguration): AuthenticationManager
    + passwordEncoder(): PasswordEncoder
  }
}

User "1" <-- "0..*" Pet : owner
UserRepository ..|> JpaRepository
PetRepository ..|> JpaRepository
UserDetailsServiceImpl ..|> UserDetailsService
JwtAuthenticationFilter --|> OncePerRequestFilter
AuthController --> AuthService
PetController --> PetService
UserController --> AuthService
AuthService --> UserRepository
AuthService --> JwtService
AuthService --> TokenBlacklistService
PetService --> PetRepository
PetService --> UserRepository
JwtAuthenticationFilter --> JwtService
JwtAuthenticationFilter --> TokenBlacklistService
JwtAuthenticationFilter --> UserDetailsServiceImpl
SecurityConfig --> JwtAuthenticationFilter
@enduml
