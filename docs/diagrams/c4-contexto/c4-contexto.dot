digraph G {
  graph [rankdir=TB, dpi=200, bgcolor="white", fontname="Arial", label="BIOPET - C4 Level 1: System Context (v1.0.0)", labelloc=t, fontsize=22];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#0F766E", fontname="Arial", fontsize=12];
  edge [fontname="Arial", fontsize=10, color="#334155"];

  vet [label="Veterinarian\n[Person]\nRegisters and manages pets;\nhandles appointments, consultations\nand vaccines.", shape=oval, fillcolor="#ECFEFF"];
  admin [label="Administrator\n[Person]\nManages pets and views\nthe global summary by species.", shape=oval, fillcolor="#ECFEFF"];
  assistant [label="Assistant\n[Person]\nManages pets and supports\nclinical staff.", shape=oval, fillcolor="#ECFEFF"];
  owner [label="Pet Owner\n[Person]\nConsults only\ntheir own pets.", shape=oval, fillcolor="#ECFEFF"];

  biopet [label="BIOPET\n[Software System]\nCentralizes pet registration and\nrole-based management\n(RBAC + JWT).", fillcolor="#DBEAFE", fontsize=14, width=3, height=1.3];

  subgraph cluster_external {
    label="External systems (v1.0.0)";
    style="dashed";
    color="#94A3B8";
    fontname="Arial";
    fontsize=11;
    fontcolor="#64748B";
    node [style="rounded,dashed", fillcolor="#F1F5F9", color="#94A3B8", fontcolor="#64748B"];
    animalApi [label="API Ninjas\n(Animals API)\n[External System]\nSpecies taxonomy, habitat\nand diet data."];
  }

  vet -> biopet [label="uses\n[HTTPS]"];
  admin -> biopet [label="uses\n[HTTPS]"];
  assistant -> biopet [label="uses\n[HTTPS]"];
  owner -> biopet [label="uses\n[HTTPS]"];

  biopet -> animalApi [label="requests species data from\n[HTTPS/JSON]", style=dashed, color="#64748B"];
}
