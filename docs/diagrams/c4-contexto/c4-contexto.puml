@startuml
!define RECTANGLE class
skinparam packageStyle rectangle
skinparam rectangle {
  BackgroundColor<<external>> #F1F5F9
  BorderColor<<external>> #94A3B8
  FontColor<<external>> #64748B
}

actor "Veterinarian" as vet
actor "Administrator" as admin
actor "Assistant" as assistant
actor "Pet Owner" as owner

rectangle "BIOPET\n[Software System]\nCentralizes pet registration\nand role-based management (RBAC + JWT)" as biopet

rectangle "API Ninjas (Animals API)\n[External System]\nSpecies taxonomy, habitat\nand diet data" as animalApi <<external>>

vet --> biopet : uses [HTTPS]
admin --> biopet : uses [HTTPS]
assistant --> biopet : uses [HTTPS]
owner --> biopet : uses [HTTPS]

biopet .down.> animalApi : requests species data from\n[HTTPS/JSON]

note bottom of animalApi
  Source of truth: docs/diagrams/workspace.dsl (Structurizr DSL).
  This C4 Level 1 view corresponds to the v1.0.0 system.
end note
@enduml
