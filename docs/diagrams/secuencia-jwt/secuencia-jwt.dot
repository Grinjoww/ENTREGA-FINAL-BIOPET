digraph Seq {
  graph [rankdir=LR, dpi=200, bgcolor="white", fontname="Arial", label="BIOPET - JWT Authentication Sequence (13 steps, cookie based)", labelloc=t, fontsize=22];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#334155", fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#475569"];
  // NOTE: conceptual English view of the flow implemented by AuthController,
  // AuthService, JwtService, JwtCookieService and JwtAuthenticationFilter.
  Angular -> AuthController [label="1 POST /api/auth/login"];
  AuthController -> AuthenticationManager [label="2 authenticate()"];
  AuthenticationManager -> UserDetailsService [label="3 loadUserByUsername()"];
  UserDetailsService -> UserRepository [label="4 findByEmail()"];
  UserRepository -> PostgreSQL [label="5 SELECT user"];
  PostgreSQL -> UserRepository [label="user"];
  AuthenticationManager -> BCrypt [label="6 matches()"];
  AuthController -> JwtService [label="7 generateAccessToken() + generateRefreshToken() HS256"];
  JwtService -> AuthController [label="JWTs with jti"];
  AuthController -> Angular [label="8 Set-Cookie access_token, refresh_token"];
  Angular -> JwtAuthFilter [label="9 Cookie: access_token"];
  JwtAuthFilter -> JwtService [label="10 validate signature and expiry"];
  JwtAuthFilter -> Redis [label="11 isRevoked(jti)"];
  JwtAuthFilter -> SecurityContext [label="12 set Authentication"];
}
