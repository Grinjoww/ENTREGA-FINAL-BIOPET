person "==Administrator\n<size:16>[Person]</size>\n\nManages pets and views the global summary by species." <<Element-RWxlbWVudCxQZXJzb24=>> as Administrator
person "==Veterinarian\n<size:16>[Person]</size>\n\nRegisters and manages pets; handles appointments, clinical consultations and vaccines." <<Element-RWxlbWVudCxQZXJzb24=>> as Veterinarian
person "==Assistant\n<size:16>[Person]</size>\n\nManages pets and supports clinical staff (ROLE_AUXILIAR)." <<Element-RWxlbWVudCxQZXJzb24=>> as Assistant
person "==Pet Owner\n<size:16>[Person]</size>\n\nConsults only their own pets, appointments, consultations and vaccines (ROLE_DUENO)." <<Element-RWxlbWVudCxQZXJzb24=>> as PetOwner
rectangle "==API Ninjas (Animals API)\n<size:16>[Software System]</size>\n\nExternal REST API. Provides species taxonomy, habitat and diet data." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwgU3lzdGVt>> as APINinjasAnimalsAPI

rectangle "BIOPET\n<size:16>[Software System]</size>" <<Boundary-QklPUEVU>> {
  database "==PostgreSQL\n<size:16>[Container: PostgreSQL 16 (dev) / 18 (prod)]</size>\n\nRelational database. Schema and stored procedures managed by Flyway migrations V1-V6." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as BIOPET.PostgreSQL
  database "==Redis / Valkey\n<size:16>[Container: Redis 7 (dev) / Valkey 8 (prod)]</size>\n\nJWT-blacklist store (by jti) and read-through cache for pets and external species data." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as BIOPET.RedisValkey
  rectangle "==Frontend\n<size:16>[Container: Angular 17, Nginx]</size>\n\nSingle-page application for authentication and for managing pets, appointments, consultations and vaccines." <<Element-RWxlbWVudCxDb250YWluZXI=>> as BIOPET.Frontend
  rectangle "==Backend API\n<size:16>[Container: Spring Boot 3.2, Java 21]</size>\n\nExposes the REST API: authentication, pets, appointments, consultations, vaccines, dashboard reports and the external-species proxy." <<Element-RWxlbWVudCxDb250YWluZXI=>> as BIOPET.BackendAPI
}

Administrator --> BIOPET.Frontend <<Relationship-UmVsYXRpb25zaGlw>> : "Uses\n<size:16>[HTTPS]</size>"
Veterinarian --> BIOPET.Frontend <<Relationship-UmVsYXRpb25zaGlw>> : "Uses\n<size:16>[HTTPS]</size>"
Assistant --> BIOPET.Frontend <<Relationship-UmVsYXRpb25zaGlw>> : "Uses\n<size:16>[HTTPS]</size>"
PetOwner --> BIOPET.Frontend <<Relationship-UmVsYXRpb25zaGlw>> : "Uses\n<size:16>[HTTPS]</size>"
BIOPET.Frontend --> BIOPET.BackendAPI <<Relationship-UmVsYXRpb25zaGlw>> : "Makes API calls to\n<size:16>[HTTPS/JSON, HttpOnly auth cookies]</size>"
BIOPET.BackendAPI --> BIOPET.PostgreSQL <<Relationship-UmVsYXRpb25zaGlw>> : "Reads from and writes to\n<size:16>[JDBC/JPA]</size>"
BIOPET.BackendAPI --> BIOPET.RedisValkey <<Relationship-UmVsYXRpb25zaGlw>> : "Reads from and writes to\n<size:16>[Redis protocol]</size>"
BIOPET.BackendAPI --> APINinjasAnimalsAPI <<Relationship-UmVsYXRpb25zaGlw>> : "Requests species data from\n<size:16>[HTTPS/JSON]</size>"

@enduml