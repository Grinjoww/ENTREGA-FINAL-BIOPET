rectangle "==API Ninjas (Animals API)\n<size:16>[Software System]</size>\n\nExternal REST API. Provides species taxonomy, habitat and diet data." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwgU3lzdGVt>> as APINinjasAnimalsAPI

rectangle "BIOPET\n<size:16>[Software System]</size>" <<Boundary-QklPUEVU>> {
  rectangle "Backend API\n<size:16>[Container: Spring Boot 3.2, Java 21]</size>" <<Boundary-QmFja2VuZCBBUEk=>> {
    rectangle "==PetController\n<size:16>[Component: Spring MVC REST Controller]</size>\n\nCRUD and search endpoints for pets." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.PetController
    rectangle "==UserController\n<size:16>[Component: Spring MVC REST Controller]</size>\n\nExposes the authenticated user's profile." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.UserController
    rectangle "==AppointmentController\n<size:16>[Component: Spring MVC REST Controller]</size>\n\nCRUD and bulk status update for appointments." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.AppointmentController
    rectangle "==ConsultationController\n<size:16>[Component: Spring MVC REST Controller]</size>\n\nRegisters and queries clinical consultations." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.ConsultationController
    rectangle "==VaccineController\n<size:16>[Component: Spring MVC REST Controller]</size>\n\nCRUD for vaccine records." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.VaccineController
    rectangle "==ExternalApiController\n<size:16>[Component: Spring MVC REST Controller]</size>\n\nExposes species information sourced from the external API." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.ExternalApiController
    rectangle "==AuthService\n<size:16>[Component: Spring Service]</size>\n\nRegistration, login, token refresh, logout and profile lookup." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.AuthService
    rectangle "==PetService\n<size:16>[Component: Spring Service]</size>\n\nPet business rules, ownership checks and the read cache." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.PetService
    rectangle "==AppointmentService\n<size:16>[Component: Spring Service]</size>\n\nAppointment business rules, scheduling and bulk status updates." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.AppointmentService
    rectangle "==ConsultationService\n<size:16>[Component: Spring Service]</size>\n\nClinical-consultation validation (active pet and veterinarian)." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.ConsultationService
    rectangle "==VaccineService\n<size:16>[Component: Spring Service]</size>\n\nVaccine record business rules." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.VaccineService
    rectangle "==ExternalApiService\n<size:16>[Component: Spring Service]</size>\n\nFetches and caches (Redis, TTL) species data from the external API." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.ExternalApiService
    rectangle "==ExternalApiClient\n<size:16>[Component: Spring Service]</size>\n\nHTTP client for API Ninjas." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.ExternalApiClient
    rectangle "==SecurityConfig\n<size:16>[Component: Spring Configuration]</size>\n\nSpring Security filter chain, providers and CORS policy." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.SecurityConfig
    rectangle "==JwtAuthenticationFilter\n<size:16>[Component: Spring Security Filter]</size>\n\nAuthenticates each request from the JWT stored in a cookie." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.JwtAuthenticationFilter
    rectangle "==JwtService\n<size:16>[Component: Spring Service]</size>\n\nIssues and validates JWTs (HMAC-SHA256, claims, expiry)." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.JwtService
    rectangle "==JwtCookieService\n<size:16>[Component: Spring Service]</size>\n\nReads/writes the HttpOnly+Secure+SameSite=Strict auth cookies." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.JwtCookieService
    rectangle "==UserDetailsServiceImpl\n<size:16>[Component: Spring Service]</size>\n\nLoads user + authorities for Spring Security." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.UserDetailsServiceImpl
    rectangle "==LoginRateLimiterService\n<size:16>[Component: Spring Service]</size>\n\nIn-memory per-IP login rate limiting." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.LoginRateLimiterService
    rectangle "==TokenBlacklistService\n<size:16>[Component: Spring Service]</size>\n\nJWT revocation via a Redis blacklist keyed by jti." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.TokenBlacklistService
    rectangle "==AuthenticationAuditService\n<size:16>[Component: Spring Service]</size>\n\nStructured authentication audit logging." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.AuthenticationAuditService
    rectangle "==ProblemAuthenticationEntryPoint\n<size:16>[Component: Spring Security Component]</size>\n\nBuilds the RFC 7807 response for 401 Unauthorized." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.ProblemAuthenticationEntryPoint
    rectangle "==ProblemAccessDeniedHandler\n<size:16>[Component: Spring Security Component]</size>\n\nBuilds the RFC 7807 response for 403 Forbidden." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.ProblemAccessDeniedHandler
    rectangle "==GlobalExceptionHandler\n<size:16>[Component: Spring @ControllerAdvice]</size>\n\nMaps application exceptions to RFC 7807 ProblemDetail responses." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.GlobalExceptionHandler
    rectangle "==ProblemDetailFactory\n<size:16>[Component: Spring Component]</size>\n\nBuilds uniform RFC 7807 ProblemDetail payloads." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.ProblemDetailFactory
    rectangle "==UserRepository\n<size:16>[Component: Spring Data JPA Repository]</size>\n\nUser persistence." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.UserRepository
    rectangle "==PetRepository\n<size:16>[Component: Spring Data JPA Repository]</size>\n\nPet persistence." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.PetRepository
    rectangle "==AppointmentRepository\n<size:16>[Component: Spring Data JPA Repository]</size>\n\nAppointment persistence." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.AppointmentRepository
    rectangle "==ConsultationRepository\n<size:16>[Component: Spring Data JPA Repository]</size>\n\nClinical-consultation persistence." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.ConsultationRepository
    rectangle "==VaccineRepository\n<size:16>[Component: Spring Data JPA Repository]</size>\n\nVaccine-record persistence." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.VaccineRepository
    rectangle "==BiopetProcedureRepository\n<size:16>[Component: Spring Data JPA Repository]</size>\n\nFormal JPA access (@Procedure / @NamedStoredProcedureQuery) to the 6 PostgreSQL stored procedures." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.BiopetProcedureRepository
    rectangle "==TomcatDualConnectorConfig\n<size:16>[Component: Spring Configuration]</size>\n\nDual HTTP/HTTPS Tomcat connector configuration (profile 'tls')." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.TomcatDualConnectorConfig
    rectangle "==AuthController\n<size:16>[Component: Spring MVC REST Controller]</size>\n\nRegistration, login, refresh and logout endpoints." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as BIOPET.BackendAPI.AuthController
  }

  database "==PostgreSQL\n<size:16>[Container: PostgreSQL 16 (dev) / 18 (prod)]</size>\n\nRelational database. Schema and stored procedures managed by Flyway migrations V1-V6." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as BIOPET.PostgreSQL
  database "==Redis / Valkey\n<size:16>[Container: Redis 7 (dev) / Valkey 8 (prod)]</size>\n\nJWT-blacklist store (by jti) and read-through cache for pets and external species data." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as BIOPET.RedisValkey
  rectangle "==Frontend\n<size:16>[Container: Angular 17, Nginx]</size>\n\nSingle-page application for authentication and for managing pets, appointments, consultations and vaccines." <<Element-RWxlbWVudCxDb250YWluZXI=>> as BIOPET.Frontend
}

